RewriteEngine On

# Auto-detect: localhost uses /noble base, production uses /
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)
RewriteRule ^ - [E=APP_BASE:/noble]

RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
RewriteRule ^ - [E=APP_BASE:/]

# Allow direct access to real files and folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Remove .php extension
# e.g. /loginpage/profile → /loginpage/profile.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Route everything else to index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# ── Seguridad: harangan ang mga nakatagong file (.env, .git, .htaccess, atbp.) ──
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # harangan din ang mga nakatagong folder (hal. /.git/config), pero hindi ang .well-known (SSL)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Custom 404 error page
ErrorDocument 404 /nobleaccounting/404.php
